# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/pairzen

# Node Environment
NODE_ENV=development

# Cookie / Session Secret
SESSION_SECRET=pairzen_super_secret_session_key_change_in_production_32_chars

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Real-Time Collaboration Service
COLLAB_PORT=3001
NEXT_PUBLIC_COLLAB_URL=http://localhost:3001

# Phase 5: Secure Code Execution & Sandbox Engine (Server-Only)
# Options: Judge0 Community Edition / Judge0 Extra CE, or rapidapi judge0 endpoint
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=your_judge0_api_key_or_token_if_authenticated
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Mock Sandbox Adapter (Set to true for deterministic offline dev/testing without Judge0)
USE_MOCK_SANDBOX=false

# Resource and execution boundaries
EXECUTION_TIMEOUT_MS=5000
MAX_SOURCE_SIZE_BYTES=65536
MAX_STDIN_SIZE_BYTES=16384

# Phase 6: AI Interview Assistant & Intelligent Feedback (Server-Only)
# AI Provider Options: "gemini" (default) | "openai" | "mock"
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-Compatible Configuration (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Mock AI Adapter (Set to true for offline dev/tests without external API keys)
USE_MOCK_AI=false

# AI Request Limits
AI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=2048
